# Public build configuration only. No AWS keys, Bedrock tokens or DB passwords.
# demo: synthetic browser-only scenarios; AI, intake and approvals disabled.
# api: all actions use the configured backend; errors never fall back to demo.
VITE_DATA_MODE=demo
# Backend root BEFORE /api, e.g. https://api.example.com/prod
# Empty in api mode means same-origin /api routes supplied by your reverse proxy.
VITE_API_BASE_URL=
VITE_API_CREDENTIALS=omit
# Optional local-only proxy when testing against the original full-stack app:
# DEV_API_PROXY=http://127.0.0.1:3200
