# Server only. Copy to .env.local. Never commit credential values.
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# Option A: Bedrock API key (no access key ID needed)
AWS_BEARER_TOKEN_BEDROCK=

# Option B: AWS workshop session credentials (leave blank when using Option A)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
